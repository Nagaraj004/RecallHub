# ==============================================================================
# RecallHub Environment Configuration Template
# Copy this file to .env and fill in real values before running
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------------------------
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database URL
# For SQLite (local zero-setup development):
# DATABASE_URL=sqlite:///./recallhub.db
# For PostgreSQL (local or Docker):
DATABASE_URL=postgresql+psycopg2://recallhub:recallhub@db:5432/recallhub

# File Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Web Push Notifications (VAPID)
# Run `npx web-push generate-vapid-keys` or generate via pywebpush
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:support@recallhub.local

# ------------------------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api/v1
